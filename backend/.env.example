# Server Configuration
PORT=5000
NODE_ENV=production

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/portfolio_basi?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
COOKIE_NAME=admin_token

# Allowed Frontend Client URLs (comma separated)
CLIENT_URL=https://basi.world,https://www.basi.world,http://localhost:3000

# Cloudinary (Media Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Initial Credentials / Fallback
ADMIN_USERNAME=basi
ADMIN_EMAIL=admin@basi.dev
ADMIN_PASSWORD=YourSecurePasswordHere
